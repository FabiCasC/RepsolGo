{
  "expo": {
    "name": "RepsolGo",
    "slug": "repsolgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "repsolgo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#041E42"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.repsolperu.repsolgo",
      "infoPlist": {
        "NSCameraUsageDescription": "Necesitamos acceso a la c\u00e1mara para escanear tus boletas.",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tu galer\u00eda para adjuntar boletas.",
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicaci\u00f3n para encontrar grifos Repsol cercanos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#041E42"
      },
      "package": "com.repsolperu.repsolgo",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir el acceso a la c\u00e1mara para escanear boletas."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir el acceso a la ubicaci\u00f3n para encontrar grifos cercanos."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
