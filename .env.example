GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# EmailJS — https://www.emailjs.com (gratis, 200 emails/mes)
# 1. Crea cuenta en emailjs.com
# 2. Add New Service → Gmail → conecta tu cuenta de Google → copia el Service ID
# 3. Email Templates → Create New Template → copia el Template ID
#    Usa estas variables en el template: {{to_email}}, {{to_name}}, {{code}}
# 4. Account → API Keys → copia el Public Key
EXPO_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
